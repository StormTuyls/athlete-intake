# Kopieer naar .env.local. Committen mag nooit.

# --- Supabase ---
# Lokaal: draai `supabase start` en neem de waarden uit de output over.
# Productie: Supabase project in regio eu-central-1 (Frankfurt).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key. Alleen server-side, nooit in de browser.
# Alle toegang tot het `medical`-schema loopt hierlangs, na authz en audit.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- App ---
# Publieke basis-URL, gebruikt in magic links en de intake-linktree.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bewaartermijn in maanden, afgedwongen door de retentiejob.
RETENTION_MONTHS=60
