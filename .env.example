# Kopieer naar .env.local. Committen mag nooit.

# --- Supabase ---
# Lokaal: draai `supabase start` en neem de waarden uit de output over.
# Productie: Supabase project in regio eu-central-1 (Frankfurt).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key. Alleen server-side, nooit in de browser.
# Alle toegang tot het `medical`-schema loopt hierlangs, na authz en audit.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- App ---
# Publieke basis-URL, gebruikt in magic links en de intake-linktree.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bewaartermijn in maanden, afgedwongen door de retentiejob.
RETENTION_MONTHS=60

# --- Directe Postgres-verbinding voor het medical-schema ---
# Loopt NIET via PostgREST: dat schema staat niet in de exposed schemas, dus de
# HTTP-API heeft er geen route naartoe. Rol intake_server mag alleen medical plus
# een paar leesrechten in public.
DATABASE_URL=

# Alleen lokaal: wachtwoord dat scripts/db-local.ts op de rol zet.
INTAKE_SERVER_PASSWORD=

# --- Notion (commerciele laag: facturatie en opvolgacties) ---
# Interne integratie-token. Deel de bovenliggende pagina met de integratie.
# Er gaat met opzet geen medische data naar Notion, zie lib/notion/sync.ts.
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=
NOTION_ATHLETES_DB=
NOTION_INVOICES_DB=
NOTION_TASKS_DB=

# Bewaartermijn na consent: 'indefinite' (standaard) of 'until_date'.
# Bij indefinite is een grond verplicht; de databank weigert anders.
RETENTION_MODE=indefinite
RETENTION_BASIS=
# Alleen gebruikt bij RETENTION_MODE=until_date.
RETENTION_MONTHS=60
