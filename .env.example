# Kopieer naar .env.local. Committen mag nooit.

# --- Supabase ---
# Lokaal: draai `supabase start` en neem de waarden uit de output over.
# Productie: Supabase project in regio eu-central-1 (Frankfurt).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key. Alleen server-side, nooit in de browser.
# Alle toegang tot het `medical`-schema loopt hierlangs, na authz en audit.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Dicteren (spraak naar tekst) ---
# Zonder sleutel verbergt de intake de microfoonknop; de rest werkt gewoon.
#
# Het endpoint is OpenAI-compatibel (multipart met `file` en `model` op
# /v1/audio/transcriptions), dus hier passen drie heel verschillende dingen in,
# en de keuze is er een over wie de audio te horen krijgt.
#
#  1. LOKAAL ONTWIKKELEN: Whisper in een container, geen derde partij.
#       TRANSCRIBE_API_KEY=lokaal
#       TRANSCRIBE_BASE_URL=http://localhost:8000/v1
#       TRANSCRIBE_MODEL=Systran/faster-whisper-large-v3
#     De sleutel mag elke waarde zijn; de route gebruikt hem als schakelaar.
#     De container heeft WHISPER__COMPUTE_TYPE=int8 nodig en het model moet
#     apart gedownload worden, anders klapt hij of weigert hij. Beide staan in
#     de README onder "Dicteren lokaal aanzetten".
#
#  2. GEHOSTE DIENST: standaard Mistral (Voxtral), een EU-partij. Dan volstaat
#     de sleutel en blijven basis-URL en model op hun standaardwaarde
#     (https://api.mistral.ai/v1 en voxtral-mini-latest).
#
#  3. EIGEN GEHOSTE WHISPER in productie: zelfde vorm als 1, maar dan een
#     machine die bereikbaar is vanaf de functions, met TLS en auth. Die
#     verwerkt medische audio en erft daarmee dezelfde eisen als de rest.
#
# Alleen bij 2 komt er een subverwerker bij. Zet hem in de tabel in
# docs/oplevering.md voordat de eerste opname vertrekt.
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=
TRANSCRIBE_MODEL=

# --- App ---
# Publieke basis-URL, gebruikt in magic links en de intake-linktree.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Directe Postgres-verbinding voor het medical-schema ---
# Loopt NIET via PostgREST: dat schema staat niet in de exposed schemas, dus de
# HTTP-API heeft er geen route naartoe. Rol intake_server mag alleen medical plus
# een paar leesrechten in public.
DATABASE_URL=

# Alleen lokaal: wachtwoord dat scripts/db-local.ts op de rol zet.
INTAKE_SERVER_PASSWORD=

# --- Notion (commerciele laag: facturatie en opvolgacties) ---
# Interne integratie-token. Deel de bovenliggende pagina met de integratie.
# Er gaat met opzet geen medische data naar Notion, zie lib/notion/sync.ts.
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=
NOTION_ATHLETES_DB=
NOTION_INVOICES_DB=
NOTION_TASKS_DB=

# --- Bewaartermijn ---
# Stond hier eerder twee keer; scripts/env.ts is eerste-wint en de meeste
# dotenv-parsers laatste-wint, dus twee keer dezelfde naam betekent dat Next en
# de scripts een andere waarde kunnen gebruiken. Eén blok, zie lib/intake/retention.ts.
#
# 'indefinite' (standaard) of 'until_date'. Bij indefinite is een grond
# verplicht: de databank weigert anders, en de applicatie ook.
RETENTION_MODE=indefinite
RETENTION_BASIS=
# Alleen gebruikt bij RETENTION_MODE=until_date.
RETENTION_MONTHS=60

# --- Cron ---
# Bearer-token waarmee Vercel /api/cron/retention aanroept. Zonder deze variabele
# weigert die route met 503: hij faalt dicht, want een vergeten instelling mag
# geen open verwijderendpoint opleveren.
CRON_SECRET=
